{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savant Code",
  "version": "0.0.28",
  "identifier": "com.savantcode.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Savant Code",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/savant-sidecar"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1N0NCRTU5QTlGNkJGNApSV1QwYTUrYTVjdFhESzY4MjVQR0Z5R0R4TmlpVGJ5TmU5bkFMQjdGNmplSy84Rmg2UXMvSER5Vgo=",
      "endpoints": [
        "https://github.com/savant0x/savant-code/releases/latest/download/latest.json"
      ]
    }
  }
}
