{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    // FID-2026-0930-003: connectors sources (reached through the
    // agent-runtime path-mapping) use `.ts` import extensions; emit is
    // declaration-only, so the flag is TS-legal here.
    "allowImportingTsExtensions": true,

    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": ["node"],
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "stripInternal": true,
    "baseUrl": ".",
    "paths": {
      "@savant-code/common/*": ["../common/src/*"],
      "@savant-code/agent-runtime/*": ["../packages/agent-runtime/src/*"],
      "@savant-code/code-map": ["../packages/code-map/src/index.ts"],
      "@savant-code/code-map/*": ["../packages/code-map/src/*"],
      "bun:sqlite": ["types/bun-sqlite.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "node_modules", "dist"]
}
