{
  "name": "@savant-code/common",
  "version": "0.0.29",
  "description": "Common utilities for Savant-Code",
  "private": true,
  "type": "module",
  "exports": {
    "./crypto": {
      "bun": "./src/crypto/index.ts",
      "import": "./src/crypto/index.ts",
      "types": "./src/crypto/index.ts",
      "default": "./src/crypto/index.ts"
    },
    "./provenance": {
      "bun": "./src/provenance/index.ts",
      "import": "./src/provenance/index.ts",
      "types": "./src/provenance/index.ts",
      "default": "./src/provenance/index.ts"
    },
    "./teacher": {
      "bun": "./src/teacher/index.ts",
      "import": "./src/teacher/index.ts",
      "types": "./src/teacher/index.ts",
      "default": "./src/teacher/index.ts"
    },
    "./*": {
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "sideEffects": false,
  "engines": {
    "bun": "1.3.11"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^1.8.0",
    "@types/pg": "^8.11.10",
    "@types/readable-stream": "^4.0.18",
    "@types/seedrandom": "^3.0.8",
    "ai": "^5.0.52",
    "gray-matter": "^4.0.3",
    "ignore": "5.3.2",
    "lodash": "4.17.23",
    "next-auth": "^4.24.11",
    "partial-json": "^0.1.7",
    "pg": "^8.14.1",
    "posthog-node": "^5.8.0",
    "readable-stream": "^4.7.0",
    "seedrandom": "^3.0.5",
    "stripe": "^16.11.0",
    "zod": "^4.2.1",
    "zod-from-json-schema": "0.4.2"
  },
  "devDependencies": {
    "@types/parse-path": "^7.1.0"
  }
}
