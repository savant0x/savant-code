{
  "name": "savant-code",
  "version": "0.0.25",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "agents",
    "cli",
    "common",
    "evals",
    "savant-free",
    "packages/agent-runtime",
    "packages/design-systems",
    "packages/code-map",
    "packages/database",
    "packages/knowledge-graph",
    "packages/llm-providers",
    "scripts/tmux",
    "sdk"
  ],
  "scripts": {
    "start-cli": "bun --cwd cli dev",
    "dev": "bun start-cli",
    "dev:savant-free": "SAVANT_FREE_MODE=true bun --cwd cli dev",
    "release:public": "bun run scripts/public-release.ts",
    "release:public:preview": "bun run scripts/public-release.ts --preview",
    "release:public:resume": "bun run scripts/public-release.ts --resume",
    "release:public:diagnose": "bun run scripts/public-release.ts --diagnose",
    "build:sdk": "cd sdk && bun run build",
    "build:savant-free": "bun savant-free/cli/build.ts 0.0.0-dev",
    "ci": "bun run build:sdk && bun run build:savant-free",
    "generate:provider-docs": "bun run scripts/generate-provider-reference.ts",
    "generate:provider-docs:check": "bun run scripts/generate-provider-reference.ts --check",
    "generate:protocol-bundle": "bun run scripts/generate-protocol-bundle.ts",
    "generate:protocol-bundle:check": "bun run scripts/generate-protocol-bundle.ts --check",
    "lint:md": "markdownlint .",
    "validate:repository": "bun scripts/validate-repository.ts",
    "quality:report": "bun scripts/quality-report.ts",
    "hygiene:check": "bun scripts/hygiene.ts",
    "design-systems:generate": "bun run scripts/generate-design-systems.ts",
    "design-systems:check": "bun run scripts/generate-design-systems.ts --check",
    "learnings:check": "bun scripts/learnings.ts",
    "audit:evidence": "bun scripts/audit-evidence.ts",
    "validate:metadata": "bun scripts/validate-repository.ts",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "bun run --cwd=common typecheck && bun run --cwd=agents typecheck && bun run --cwd=sdk typecheck && bun run --cwd=cli typecheck && bun run --cwd=evals typecheck && bun run --cwd=packages/agent-runtime typecheck && bun run --cwd=packages/design-systems typecheck && bun run --cwd=packages/code-map typecheck && bun run --cwd=packages/database typecheck && bun run --cwd=packages/knowledge-graph typecheck && bun run --cwd=packages/llm-providers typecheck",
    "test": "bun run --cwd=sdk test && bun run --cwd=cli test && bun run --cwd=common test && bun run --cwd=agents test && bun run --cwd=evals test:v2 && bun run --cwd=packages/agent-runtime test && bun run --cwd=packages/design-systems test && bun run --cwd=packages/code-map test && bun run --cwd=packages/database test && bun run --cwd=packages/knowledge-graph test && bun run --cwd=packages/llm-providers test",
    "version:bump": "bun run scripts/bump-version.ts",
    "version:check": "bun run scripts/bump-version.ts --check"
  },
  "dependencies": {
    "@savant-code/design-systems": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "canvas": "^3.2.0",
    "gif-encoder-2": "^1.0.5",
    "zod": "^4.2.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ai": "5.0.122",
    "@ai-sdk/gateway": "2.0.28",
    "@ai-sdk/provider": "2.0.1",
    "@ai-sdk/provider-utils": "3.0.20",
    "baseline-browser-mapping": "^2.9.14",
    "caniuse-lite": "^1.0.30001792",
    "zod": "^4.2.1",
    "signal-exit": "3.0.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.3.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-fetch": "^2.6.12",
    "@types/parse-path": "^7.1.0",
    "@types/react-dom": "19.2.3",
    "bun-types": "1.3.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "ignore": "^6.0.2",
    "lodash": "4.17.23",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "ts-pattern": "^5.9.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
