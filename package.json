{
  "name": "savant-code",
  "version": "0.0.17",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "agents",
    "cli",
    "common",
    "evals",
    "savant-free",
    "packages/agent-runtime",
    "packages/code-map",
    "packages/database",
    "packages/llm-providers",
    "scripts/tmux",
    "sdk"
  ],
  "scripts": {
    "start-cli": "bun --cwd cli dev",
    "dev": "bun start-cli",
    "dev:savant-free": "SAVANT_FREE_MODE=true bun --cwd cli dev",
    "release:cli": "bun run --cwd=cli release",
    "release:sdk": "bun run --cwd=sdk release",
    "release:savant-free": "bun run --cwd=savant-free release",
    "build:sdk": "cd sdk && bun run build",
    "build:savant-free": "bun savant-free/cli/build.ts 0.0.0-dev",
    "buffbench": "bun --cwd evals run-buffbench",
    "ci": "bun run build:sdk && bun run build:savant-free",
    "lint:md": "markdownlint .",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "bun run --cwd=common typecheck && bun run --cwd=agents typecheck && bun run --cwd=sdk typecheck && bun run --cwd=cli typecheck && bun run --cwd=evals typecheck && bun run --cwd=packages/agent-runtime typecheck && bun run --cwd=packages/code-map typecheck && bun run --cwd=packages/database typecheck && bun run --cwd=packages/llm-providers typecheck"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "canvas": "^3.2.0",
    "gif-encoder-2": "^1.0.5",
    "zod": "^4.2.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ai": "5.0.122",
    "@ai-sdk/gateway": "2.0.28",
    "@ai-sdk/provider": "2.0.1",
    "@ai-sdk/provider-utils": "3.0.20",
    "baseline-browser-mapping": "^2.9.14",
    "caniuse-lite": "^1.0.30001792",
    "zod": "^4.2.1",
    "signal-exit": "3.0.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.3.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-fetch": "^2.6.12",
    "@types/parse-path": "^7.1.0",
    "@types/react-dom": "19.2.3",
    "bun-types": "1.3.11",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "ignore": "^6.0.2",
    "lodash": "4.17.23",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "ts-pattern": "^5.9.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
