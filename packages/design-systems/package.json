{
  "name": "@savant-code/design-systems",
  "version": "0.0.26",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "generate": "bun run ../../scripts/generate-design-systems.ts",
    "generate:check": "bun run ../../scripts/generate-design-systems.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.2.1"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
