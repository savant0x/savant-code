{
  "extends": "../tsconfig.base.json",
  "ts-node": {
    "esm": true
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "outDir": "./dist",
    // Disabling declaration emit avoids TS6059 rootDir conflicts when
    // cross-workspace path mappings (e.g. @savant-code/sdk) pull source
    // files outside the cli/ directory into the compilation unit.
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "preserveSymlinks": false,
    "paths": {
      "@savant-code/sdk": ["../sdk/src/index.ts"],
      "@savant-code/common/*": ["../common/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
