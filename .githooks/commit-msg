#!/usr/bin/env bash
# Commit-message hook — prevent unauthorized third-party contributor attribution.
#
# GitHub turns Co-authored-by trailers into contributor credit on the repo
# page. This local guard blocks the known unauthorized coding-agent
# identities (CommandCodeBot + Codebuff, incl. their "Generated with/by"
# watermark lines) before a commit is created. It intentionally allows
# unrelated legitimate co-authors.
#
# Wired through the repository's core.hooksPath (.githooks). A local hook can be
# bypassed with `git commit --no-verify`; CI/server-side policy is required for
# enforcement across every clone. The pre-push hook (scripts/pre-push-scan.ts)
# re-verifies pushed commit messages fail-closed, so a bypassed commit-msg
# hook still cannot push watermarked messages to the remote.

set -u

MESSAGE_FILE="${1-}"
if [ -z "$MESSAGE_FILE" ] || [ ! -f "$MESSAGE_FILE" ] || [ ! -r "$MESSAGE_FILE" ]; then
  echo "❌ commit-msg: Git did not provide a readable commit-message file" >&2
  exit 2
fi

grep -Eiq '^[[:space:]]*(co-authored-by:[[:space:]].*(commandcodebot|commandcode[.]ai|codebuff)|(generated with|generated by)[[:space:]]+codebuff)' -- "$MESSAGE_FILE"
grep_status=$?
case "$grep_status" in
  0)
    echo "❌ commit-msg: unauthorized coding-agent attribution watermark detected" >&2
    echo "   Remove the Codebuff/CommandCodeBot Co-Authored-By trailer or" >&2
    echo "   'Generated with/by …' watermark line before committing." >&2
    echo "   This local guard can be bypassed with --no-verify only when explicitly authorized." >&2
    exit 1
    ;;
  1)
    exit 0
    ;;
  *)
    echo "❌ commit-msg: unable to scan the commit-message file; refusing the commit" >&2
    exit 2
    ;;
esac