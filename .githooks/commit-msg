#!/usr/bin/env bash
# Commit-message hook — no coding agent may be attributed in this repository.
#
#   RULE (operator, 2026-10-14, verbatim): "it's 100% forbidden from any coding
#   agent to tag my repo". There is no authorized exception, no approval path,
#   and no agent who may use one.
#
# GitHub converts `Co-Authored-By:` trailers into contributor credit on the
# repository page, and `Generated with …` lines advertise the tool in permanent
# history; the 2026-08-17 incident needed a history rewrite to undo 21 of them.
#
# The rule lives in ONE place (scripts/attribution-guard.ts) and this hook is one
# of three enforcement points over it:
#   1. this hook (local commit)
#   2. .githooks/pre-push → scripts/pre-push-scan.ts (pushed commit range)
#   3. .github/workflows/attribution-guard.yml (CI, un-skippable from a clone)
#
# `git commit --no-verify` skips this hook — that is how git works, not a policy
# choice, and it is NEVER an authorization to queue a watermarked commit: the
# pre-push range scan and CI reject it again. No agent may use it, and no human
# instruction to use it makes the tag lawful.

set -u

MESSAGE_FILE="${1-}"
if [ -z "$MESSAGE_FILE" ] || [ ! -f "$MESSAGE_FILE" ] || [ ! -r "$MESSAGE_FILE" ]; then
  echo "❌ commit-msg: Git did not provide a readable commit-message file" >&2
  exit 2
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "❌ commit-msg: bun is required to run the attribution guard; refusing the commit" >&2
  exit 2
fi

bun "$(git rev-parse --show-toplevel)/scripts/attribution-guard.ts" --message-file "$MESSAGE_FILE"
status=$?
case "$status" in
  0)
    exit 0
    ;;
  1)
    exit 1
    ;;
  *)
    echo "❌ commit-msg: the attribution guard could not complete; refusing the commit" >&2
    exit 2
    ;;
esac
