{
  "set": "savant-cyberdeck",
  "version": "3.0.0",
  "created": "2026-10-09",
  "description": "Custom cyberpunk icon set for the Savant CLI: 132 hand-authored vector icons in the canonical Savant neon palette — the identity core (logo, S-monogram), 10 ECHO agent roles and 5 protocol marks with 5 variation marks, the Perfection Loop phase vocabulary plus 4 generic run-lifecycle marks, 20 tool glyphs, 13 status indicators, 15 command marks, 15 dev-object marks, 15 cyberpunk motif marks, 6 sidebar-section marks, 4 activity indicators, 4 nav glyphs, 4 alert glyphs, and 2 toggle glyphs. No external assets, no icon fonts, no downloaded content.",
  "viewBox": "0 0 64 64",
  "palette": {
    "cyan": "#18faf9",
    "magenta": "#ff2bd6",
    "blue": "#4fa8ff",
    "white": "#ffffff",
    "green": "#3dff9a",
    "acid": "#f3e600"
  },
  "paletteSources": [
    "cli/src/utils/theme-system/icon-palette.ts (ICON_PALETTE export)"
  ],
  "style": {
    "strokeWidth": 3,
    "detailWidth": 1.5,
    "linecap": "round",
    "linejoin": "round",
    "ground": "transparent",
    "glow": "feGaussianBlur merge filter, stdDeviation 2.5",
    "familyRule": "every icon shares the circuit-trace + node-dot grammar; magenta = the mind/energy, cyan = the structure, blue = the frame, green = verification, acid = the caveat",
    "motifs": [
      "circuit traces with 90-degree elbows",
      "terminal node dots",
      "neon glow",
      "HUD corner brackets",
      "glitch offset layer",
      "scanlines"
    ]
  },
  "vocabulary": {
    "perfectionLoopPhases": [
      "idle",
      "red",
      "green",
      "audit",
      "self_correct",
      "complete"
    ],
    "phaseMarkMapping": {
      "idle": "phase-idle.svg",
      "red": "phase-red.svg",
      "green": "phase-green.svg",
      "audit": "phase-audit.svg",
      "self_correct": "phase-self-correct.svg",
      "complete": "phase-complete.svg"
    },
    "subMarks": {
      "implement": "phase-implement.svg — the GREEN implementation sub-mark",
      "archive": "phase-archive.svg — the FID-archival duty at complete"
    },
    "runLifecycle": ["active", "error", "fix", "done"],
    "note": "The ECHO Perfection Loop vocabulary is authoritative for phase-* marks; run-* marks carry the generic run lifecycle (the engine running, a flaw identified, repair in progress, shipped and archived)."
  },
