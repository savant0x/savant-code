# =============================================================================
# Savant Code CLI — Local Development Environment Template
# =============================================================================
# COPY NOTICE:
# Copy this file to `.env.local` before local development:
#
#   cp .env.example .env.local       # macOS/Linux
#   copy .env.example .env.local     # Windows Command Prompt
#
# `.env.local` is gitignored. Replace dummy credential values with real local
# values only; never commit `.env.local` or paste live credentials into source.
# This file intentionally preserves the complete configuration surface used by
# the local CLI, direct-provider mode, optional gateway providers, backend mode,
# release-adjacent local configuration, and required client environment validation.
#
# All credential values below are safe placeholders. The variable names and
# commented state below mirror the local development configuration; do not
# rename or remove entries when creating `.env.local`.

# -----------------------------------------------------------------------------
# Core environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CB_ENVIRONMENT=dev
NEXT_PUBLIC_WEB_PORT=3000

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
# Used by getWebsiteUrl() for non-inference backend calls. With direct
# OpenRouter inference enabled, remaining backend calls still use this URL.
NEXT_PUBLIC_SAVANT_CODE_APP_URL=http://localhost:3000

# Optional separate free product URL (FID-2026-0806-013).
# NEXT_PUBLIC_SAVANT_FREE_APP_URL=http://localhost:3001
# Legacy pre-rebrand alias — still read as a fallback if set:
# NEXT_PUBLIC_FREEBUFF_APP_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Analytics / observability (dummy values)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_API_KEY=phc_dummy_replace_me
NEXT_PUBLIC_POSTHOG_HOST_URL=http://localhost:4000
NEXT_PUBLIC_GRAVITY_PIXEL_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Support / billing (dummy values)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=replace-me@example.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_dummy_replace_me
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL=http://localhost:3000/portal
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION_ID=dummy_replace_me

# -----------------------------------------------------------------------------
# Inference — OpenRouter direct mode
# -----------------------------------------------------------------------------
# Set DIRECT_PROVIDER and INFERENCE_BASE_URL to bypass the Savant Code backend
# for inference. The SDK resolves the OpenRouter credential in this order:
#   1. OR_MASTER_KEY — exchanges for a regular key via /api/v1/keys
#   2. OPENROUTER_API_KEY — regular OpenRouter key
#   3. INFERENCE_API_KEY — SDK-specific inference key
DIRECT_PROVIDER=openrouter
INFERENCE_BASE_URL=https://openrouter.ai/api/v1
OR_MASTER_KEY=sk-or-master-dummy-replace-me

# Leave INFERENCE_BASE_URL unset to use the Savant Code backend by default.

# -----------------------------------------------------------------------------
# Inference — Gateway providers (generated from the provider registry)
# Run `bun run generate:provider-docs` to regenerate — do not edit by hand.
# -----------------------------------------------------------------------------
# GENERATED:provider-gateway-env-start
# OpenRouter: https://openrouter.ai/api/v1 (resolver: OR_MASTER_KEY → OPENROUTER_API_KEY → INFERENCE_API_KEY)
OPENROUTER_API_KEY=dummy-openrouter_api_key-replace-me

# TokenRouter: https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=dummy-tokenrouter_api_key-replace-me

# NVIDIA NIM: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=dummy-nvidia_api_key-replace-me

# OpenCode Go: https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=dummy-opencode_go_api_key-replace-me

# Cloudflare: https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1
CLOUDFLARE_API_TOKEN=dummy-cloudflare_api_token-replace-me
# Cloudflare Account ID (CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_ACCOUNT_ID=dummy-cloudflare_account_id-replace-me

# CommandCode: https://api.commandcode.ai/provider/v1
COMMAND_CODE_API_KEY=dummy-command_code_api_key-replace-me

# Nous Research: https://inference-api.nousresearch.com/v1
NOUS_API_KEY=dummy-nous_api_key-replace-me

# TokenHarbor: https://tokenharbor.ai/v1
TOKENHARBOR_API_KEY=dummy-tokenharbor_api_key-replace-me
# GENERATED:provider-gateway-env-end

# -----------------------------------------------------------------------------
# Research — BYOK API keys (optional; research is keyless by default)
# -----------------------------------------------------------------------------
# web_search / read_docs / deep_research work with ZERO keys out of the box:
# web search falls back to a keyless Qwant + DuckDuckGo port, and read_docs
# falls back to a self-populating local SQLite docset cache. Set any of the
# following to opt into a Bring-Your-Own-Key source for higher quality and
# rate-limit headroom. Keys entered via `/research-keys <service>` are saved
# to credentials.json and applied at boot; shell environment takes precedence.
# SERPER_API_KEY=dummy-serper_api_key-replace-me      # Serper web search
# CONTEXT7_API_KEY=dummy-context7_api_key-replace-me    # Context7 indexed documentation
# PARALLEL_API_KEY=dummy-parallel_api_key-replace-me    # Parallel search API
# TAVILY_API_KEY=dummy-tavily_api_key-replace-me        # Tavily AI search
# EXA_API_KEY=dummy-exa_api_key-replace-me              # Exa neural search
# FIRECRAWL_API_KEY=dummy-firecrawl_api_key-replace-me  # Firecrawl web search

# -----------------------------------------------------------------------------
# Auth — Savant Code backend mode
# -----------------------------------------------------------------------------
# SAVANT_CODE_API_KEY is used for Savant Code backend calls. When
# INFERENCE_BASE_URL is set, local direct-provider development can bypass this
# key. Uncomment and replace the dummy value when using backend mode.
# SAVANT_CODE_API_KEY=

# -----------------------------------------------------------------------------
# Worker / deployment integration (dummy value)
# -----------------------------------------------------------------------------
# Worker/deployment credential used by local deployment integrations.
AMAZON_WORKER=amazon-worker-dummy-replace-me
